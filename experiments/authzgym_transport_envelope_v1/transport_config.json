  "connectivity_probe": {
    "path": "/models",
    "connect_timeout_seconds": 15,
    "timeout_seconds": 30,
    "paid_inference": false
  },
  "http_connection_strategy": "fresh_curl_process_per_api_submission_no_shared_pool",
  "proxy_dns_mode": "socks5h_remote_resolution",
  "tls_verification": false,
  "stripped_ssh_environment_names": [
    "OPENAI_API_KEY",
    "OPENAI_BASE_URL"
  ]
