{
  "protocol_id": "authzgym-transport-envelope-v1",
  "ssh_binary": "ssh",
  "remote_host": "nopales17@wiseau.seclab.cs.ucsb.edu",
  "local_bind_host": "127.0.0.1",
  "preferred_local_port": 47819,
  "exit_on_forward_failure": true,
  "keepalive": {
    "server_alive_interval_seconds": 15,
    "server_alive_count_max": 2,
